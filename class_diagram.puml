@startuml
left to right direction

class Armrest {
    bool is_activated
    string heating
    string material
    string color

    + check_activation(): void
    + remove_parameters(): void
}

class CupHolder {
    bool is_activated
    string usb_socket
    string color

    + check_activation(): void
    + remove_parameters(): void
}

class Framework {
    bool is_activated
    string material
    string color

    + check_activation(): void
    + remove_parameters(): void
}

class LowerPanel {
    bool is_activated
    string functionality
    string is_cup
    string color

    + check_activation(): void
    + remove_parameters(): void
}

class MiddlePanel {
    bool is_activated
    string functionality

    + check_activation(): void
    + remove_parameters(): void
}

class UpperPanel {
    bool is_activated
    string controlable
    string ac_type

    + check_activation(): void
    + remove_parameters(): void
}

class Body {

    int body_id
    UpperPanel upper_panel
    MiddlePanel middle_panel
    LowerPanel lower_panel
    Armrest Armrest
    CupHolder cup_holder
    Framework framework

    + remove_parameters(): void
    + check_parts_activation(): void
    + __str__(): string
}

class FileDialog {
    
    list file_name
    QLabel label

    + show_file_dialog: void
}

class QLabel {

}

class QWidget {

}

class MatPlotlibWidget {
    
    list list_of_bars
    list plot_colors
    list list_of_machines_p
    list list_of_durations
    list list_of_starting_times
    list tasks
    int color_iter
    int number_of_plots
    PetriNet petri_net

    + update_plot(): void
    + calculate_durations(): void
    + calculate_starting_times(): void
    + calculate_prev_part_times(): void
    + check_previous_times(): bool
    + sum_durations(): int
}

class ReadJSON {

    string file_name

    + parse_json(): void
    + add_new_cb_group_box(): void
    + assign_body_parts(): Body
}

class Place {

    string name
    string description
    int tokens
    int ready_tokens
    int cooldown_ms
    int max_tokens
    InfoTerminal info_terminal

    + set_terminal(): void
    + print_info(): void
    + __str__(): string
}

class Transition {

    string name
    dict inputs
    dict outputs

    + is_enabled(): void
    + can_fire(): bool 
    + fire(): void
    + __str__(): string
}

class PetriNet {

    dict places
    dict transitions

    + add_place(): void
    + add_transition(): void
    + fire_transition(): void
    + set_info_terminal(): void
    + __str__(): string 
}

class AnimatedButton {

    + animate_click(): void
    + animate_reverse(): void
}

class QPushButton {

}

class Worker {

    pyqtSignal finished_body_s
    pyqtSignal add_text_s

    int started_bodys
    int bodys_in_production
    int executed_bodys
    list available_tr

    + run(): void
    + remove_duplicates(lst: list): list
}

class Listener {

    Queue task_queue
    list available_tr

    + run(): void
    + update_available_tr(body: Body): void
    + define_available_tr(available_bp_tr: dict, body: Body): void
}


class CarBodyGroupBox {

    QGroupBox group_box
    Body body
    string label_text
    QLabel label
    AnimatedButton button_schedule
    AnimatedButton button_delete

    + get_car_body_group_box(): CarBodyGroupBox
    + update_body(): void
}

class InfoTerminal {

    int buffor_size
    list list_of_info_group_box

    + add_text_info(): void
}

