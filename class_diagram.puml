class GUI {

    int body_counter
    Body body_tmp
    list list_of_threads
    list list_of_readio_buttons
    list list_of_car_body_group_box
    list list_of_info_group_box
    list list_of_bodys
    PetriNet petri_net
    InfoTerminal info_terminal

    + create_tabs_content(): void
    + create_sub_tab_framework_content(): QWidget
    + create_sub_tab_upper_panel_content(): QWidget
    + create_sub_tab_middle_panel_content(): QWidget
    + create_sub_tab_lower_panel_content(): QWidget
    + create_sub_tab_armrest_content(): QWidget
    + create_sub_tab_cup_holder_content(): QWidget
    + create_group_box_body(): void
    + on_change_cbox_framework_material(index: int): void
    + on_change_cbox_framework_color(index: int): void
    + on_change_cbox_lower_panel_color(index: int): void
    + on_change_cbox_armrest_material(index: int): void
    + on_change_cbox_armrest_color(index: int): void
    + on_change_cbox_cup_holder_color(index: int): void
    + on_radio_button_upper_panel_clicked(): void
    + on_radio_button_middle_panel_clicked(): void
    + on_radio_button_lower_panel_clicked(): void
    + on_radio_button_armrest_clicked(): void
    + on_radio_button_cup_holder_clicked(): void
    + pb_add_clicked(): void
    + pb_read_json(): void
    + pb_chose_file(): void
    + pb_add_body(): void
    + pb_schedule_clicked(body_id: int): void
    + pb_delete_clicked(body_id: int): void
    + on_thread_finished(thread_id: int) void
    + check_body_group_box_number(): void
    + create_label(label_str: str, maximuxm_height: int): QLabel
    + create_radio_button(label_str: str, signal_function: void): QRadioButton
    + create_combo_box(list_of_elements: list, signal_function: void): QComboBox
    + emit_thread_add_text(text: string): void
    + update_label(): void
    + update_prooduction_counter(value: int): void
    + update_finished_counter(): void
